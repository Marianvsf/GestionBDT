# ==============================
# GestionBDT - Environment setup
# ==============================

# DB_CONNECTION: pgsql | sqlite
DB_CONNECTION=pgsql

# PostgreSQL (opción A)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestionbdt
DB_USERNAME=postgres
DB_PASSWORD=postgres

# PostgreSQL URL (opción B, prioridad más alta si existe)
# Ejemplo: postgres://user:password@host:5432/database
DATABASE_URL=

# SQLite (fallback local)
# Solo se usa si DB_CONNECTION=sqlite
SQLITE_PATH=database/bdt.sqlite
