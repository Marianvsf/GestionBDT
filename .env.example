# ==============================
# GestionBDT - Environment setup
# ==============================

# DB_CONNECTION: pgsql | sqlite
DB_CONNECTION=pgsql

# PostgreSQL (opción A)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestionbdt
DB_USERNAME=postgres
DB_PASSWORD=postgres

# PostgreSQL URL (opción B, prioridad más alta si existe)
# Ejemplo: postgres://user:password@host:5432/database
DATABASE_URL=

# Docker Compose – contraseña para el servicio de base de datos
# Requerido: copiar este archivo como .env y cambiar el valor antes de usar docker compose up
POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres
POSTGRES_DB=gestionbdt
